use v6.d;
use Test;

use Math::NIntegrate;
use Math::NIntegrate::Rule::MonteCarlo;
use Math::NIntegrate::Region;

# 1
ok Math::NIntegrate::Rule::MonteCarlo.new(100);

# 2
subtest {
    # Integrand
    my &f = {$_ ** 2};

    # The undefined integral of &f is x^3/3 .
    my &fExact = {$_ ** 3 / 3};

    my $numerical-function = Math::NIntegrate::NumericalFunction.new(&f, working-precision => Rat);

    # Exact value
    my ($a, $b) = 0, 2;
    my $exact = &fExact($b) - &fExact($a);

    my $rule = Math::NIntegrate::Rule::MonteCarlo.new(100);

    # Region
    my $region = Math::NIntegrate::Builder.make-region(
            $numerical-function,
            [$a,],
            [$b,],
            :$rule);

    isa-ok $region.apply-rule, Math::NIntegrate::Region:D, 'region integration rule integrate';

    $region.apply-rule;

    #say (:$exact, integral => $region.integral, error => $region.error);

    is abs($region.integral - $exact) / $exact ≤ 0.3, True, 'expected integral estimate';

    # It fails too often
    # is $region.error.abs / $exact ≤ 0.4, True, 'expected error estimate';

}, 'Monte-Carlo integration in a region';

# 3
subtest {

    ok nintegrate( { $^x }, <x 0 1>, method => 'MonteCarloRule', :1precision-goal, max-recursion => 2);

    isa-ok nintegrate( { $^x }, <x 0 1>, method => 'MonteCarloRule', :1precision-goal, max-recursion => 2), Numeric:D;

    my %res = nintegrate( { $^x }, <x 0 1>, method => 'MonteCarloRule', :1precision-goal, max-recursion => 2):pairs;

    is-approx %res<integral>, 1/2, rel-tol => 0.2, 'expected 1D integral value';

}, 'Monte-Carlo rule from top-level';

done-testing;

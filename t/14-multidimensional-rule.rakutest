use v6.d;
use Test;

use Math::NIntegrate::Rule::MultiDimensional;
use Math::NIntegrate::NumericalFunction;
use Math::NIntegrate::Region;
use Math::NIntegrate::Builder;

subtest {
    my $rule = Math::NIntegrate::Rule::MultiDimensional.new(:2dimension);
    my %data = $rule.d07hre(2);

    is %data<weights>.elems, 5, 'D07HRE returns the basic rule and four null rules';
    is %data<weights>[0].elems, 6, 'each rule has six generator weights';
    is %data<generators>.elems, 2, 'one generator coordinate row per dimension';
    is %data<rule-points>, [1e0, 4e0, 4e0, 4e0, 4e0, 4e0], 'two-dimensional orbit sizes';
    is %data<error-coefficients>, [5e0, 5e0, 1e0, 5e0, 0.5e0, 0.25e0], 'DCUHRE error coefficients';

    for ^5 -> $rule-index {
        my $constant-moment = [+] (^6).map({
            %data<rule-points>[$_] * %data<weights>[$rule-index][$_]
        });
        my $expected = $rule-index == 0 ?? 4e0 !! 0e0;
        ok abs($constant-moment - $expected) < 1e-12,
                "rule $rule-index has the expected constant moment";
    }

    ok abs(%data<generators>[0][5] - sqrt(0.4707e0) / 2e0) < 1e-12,
            'last generator uses the half-scaled sqrt(lambda0)';
    ok %data<generators>.map(*.Slip).min >= 0e0
            && %data<generators>.map(*.Slip).max <= 0.5e0,
            'degree-seven canonical generator offsets are in [0, 1/2]';
    my %degree-nine = $rule.d09hre(2);
    ok %degree-nine<generators>.map(*.Slip).max <= 0.5e0,
            'degree-nine generator offsets are at most 1/2';

    is %data<generators>[1][4], %data<generators>[0][4],
            'the penultimate generator has two lambda1 coordinates';

    dies-ok { $rule.d07hre(0) }, 'zero dimension is rejected';

}, 'D07HRE creation';


subtest {
    sub f($x, $y) { $x + $y }

    my $rule = Math::NIntegrate::Rule::MultiDimensional.new(:2dimension);
    my $numerical-function = Math::NIntegrate::NumericalFunction.new(&f);
    my $region = Math::NIntegrate::Builder.make-region(
            $numerical-function, [0, 0], [1, 1], :$rule);

    my %sum = $rule.defshr([0.25, 0], $region, :offset(0.5));

    ok abs(%sum<fulsms> - 4e0) < 1e-12,
            'DEFSHR sums distinct permutations and sign changes';
}, 'DEFSHR fully symmetric sum';

subtest {
    sub f($x, $y) { $x + $y ** 2 }

    my $rule = Math::NIntegrate::Rule::MultiDimensional.new(:2dimension, :9generators);
    my $numerical-function = Math::NIntegrate::NumericalFunction.new(&f);
    my $region = Math::NIntegrate::Builder.make-region(
            $numerical-function, [0, 0], [1, 1], :$rule);

    isa-ok $rule.integrate($region), Math::NIntegrate::Rule::MultiDimensional:D,
            'integration returns the rule';
    ok abs($rule.integral - 5e0 / 6e0) < 1e-12,
            'DERLHR integrates a polynomial over the unit square';
    ok $rule.error > 0e0 && !($rule.error.isNaN || $rule.error ~~ Inf | -Inf),
            'DERLHR produces a finite positive error estimate';

    my $region2 = Math::NIntegrate::Builder.make-region(
            $numerical-function, [0, 0], [3, 5], :$rule);

    $rule.integrate($region2);

    #say ($rule.integral, $rule.error, $rule.largest-error-axis);

    ok abs($rule.integral - 295 / 2) < 1e-12,
            'DERLHR integrates a polynomial over the square [0, 3] x [0, 5] parallelepiped';
}, 'DERLHR integration';

subtest {
    sub f($x, $y) { $y ** 4 }

    my $rule = Math::NIntegrate::Rule::MultiDimensional.new(:2dimension);
    my $numerical-function = Math::NIntegrate::NumericalFunction.new(&f);
    my $region = Math::NIntegrate::Builder.make-region(
            $numerical-function, [0, 0], [1, 1], :$rule);

    $rule.integrate($region);

    is $rule.largest-error-axis, 1,
            'DERLHR selects the axis with the largest fourth difference';
}, 'DERLHR subdivision axis';

done-testing;
use v6.d;
use Test;

use Math::NIntegrate::NumericalFunction;
use Math::NIntegrate::Rule::Trapezoidal;
use Math::NIntegrate::Region;
use Math::NIntegrate::Builder;

plan *;

## 1
subtest {

    # Integrand
    sub f($x) { $x.sqrt }
    my $numerical-function = Math::NIntegrate::NumericalFunction.new(&f, working-precision => Rat);

    # Integration rule
    my $rule = Math::NIntegrate::Rule::Trapezoidal.new(3);

    # Region
    my $region = Math::NIntegrate::Builder.make-region(
            $numerical-function,
            [0, ],
            [5, ],
            :$rule);

    # Integrate
    $region.rule.integrate($region);

    # Partition points (which $region.partition computes)
    my @new-bounds = $region.rule.abscissas.map({ $region.variable-transformer.transform(point => [$_,], jacobian => 1)<point>.head });
    @new-bounds = [
        $region.variable-transformer.get-transform-bounds<min>.head,
        |@new-bounds,
        $region.variable-transformer.get-transform-bounds<max>.head
    ].unique.sort;

    # Partition tests
    isa-ok $region.clone.partition(@new-bounds), Positional:D, 'region partition call ok';

    # Partition the original region
    my @regions = $region.partition(@new-bounds);

    is @regions.all ~~ Math::NIntegrate::Region:D, True, 'a list of region objects';

    # Boundaries after the partition
    is
            @regions.map({ .variable-transformer.get-transform-bounds<min>[0] }).unique.sort,
            @new-bounds.head(*-1),
            'expected min boundaries';

    is
            @regions.map({ .variable-transformer.get-transform-bounds<max>[0] }).unique.sort,
            @new-bounds.tail(*-1),
            'expected max boundaries';

}, 'Region partition';

## 2
subtest {

    # Integrand
    sub f($x) { $x.sqrt }
    my $numerical-function = Math::NIntegrate::NumericalFunction.new(&f, working-precision => Rat);

    # Integration rule
    my $rule = Math::NIntegrate::Rule::Trapezoidal.new(3);

    # Region
    my $offset = 0.02;
    my $region = Math::NIntegrate::Builder.make-region(
            $numerical-function,
            [$offset,     $offset],
            [$offset + 5, $offset + 12],
            :$rule);

    my $volume = 5 * 12;
    is $region.volume, $volume, 'expected region volume';

    my @divisions = 2, 3;

    # Partition tests
    isa-ok $region.clone.divide(@divisions), Positional:D, 'region divide call ok';

    # Divide the original region
    my @regions = $region.divide(@divisions);

    is @regions.all ~~ Math::NIntegrate::Region:D, True, 'a list of region objects';

    is @regions.elems, 6, 'expected number of region objects';

    # Boundaries after the partition
    is
            @regions.map({ .variable-transformer.get-transform-bounds<min>[0] }).sort,
            [0, 0, 0, 2.5, 2.5, 2.5] >>+>> $offset,
            'expected min boundaries';

    is
            @regions.map({ .variable-transformer.get-transform-bounds<max>[1] }).sort,
            [4, 4, 8, 8, 12, 12] >>+>> $offset,
            'expected max boundaries';

    is ([+] |@regions>>.volume), $volume, 'expected volume';

}, 'Region division';

done-testing;

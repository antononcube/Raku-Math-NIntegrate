use v6.d;
use Test;

use Math::NIntegrate;
use Math::NIntegrate::Spec;
use Math::NIntegrate::Builder;
use Math::NIntegrate::Strategy::LocalAdaptive;

plan *;

# 1
subtest {
    my &f = { 1 / $^x.sqrt };
    my @ranges = <x 0 1>, ;
    my $method = ('local-adaptive', partitioning => 3);

    # Check and normalize
    my $spec = Math::NIntegrate::Spec.new(&f, @ranges, %(:$method));

    # Integrator object
    my $integrator = Math::NIntegrate::Builder.new.make-integrator(
            integrand => $spec.integrand,
            ranges => $spec.ranges,
            |$spec.options);

    isa-ok $integrator, Math::NIntegrate::Strategy::LocalAdaptive:D, 'expected integrator type';

    is $integrator.partitioning, 3, 'expected integrator attribute value';

}, 'Creation';


# 2
subtest {
    my &f = { 1 / $^x.sqrt };

    my %res = nintegrate(&f, <x 0 1>,  method => ('LocalAdaptive', partitioning => 2, singularity-depth => 2), max-recursion => 9):pairs;

    is-approx %res<integral>, 2, rel-tol => 1e-6, abs-tol => 1e-6, 'integral estimate';

}, '1D sinqular integral';


# 3
subtest {
    my &f = {$^x + $^y ** 2};
    # The undefined integral of &f is (x^2 y)/2 + (x y^3)/3.
    # The exact value in [0, 1] x [0, 1] is 5/6.
    # The exact value in [0, 3] x [0, 5] is 295/2.
    my $exact = 295/2;

   isa-ok
           nintegrate(&f, ('x', 0, 3), ('y', 0, 5),
                   method => ('LocalAdaptive', method => 'MultiDimensionalRule'),
                   max-recursion => 3),
           Numeric:D,
           'ok to call';

    my %res = nintegrate(&f, ('x', 0, 3), ('y', 0, 5),
            method => 'LocalAdaptive',
            max-recursion => 3):pairs;

    # Num
    is abs(%res<integral> - $exact) ≤ 1e-6, True, 'expected Num result';

}, 'nintegrate({$^x + $^y ** 2}, <x 0 3>, <y 0 5>)';


# 4
subtest {
    # This tests for proper region boundaries computation by Region::divide
    my &f = { $^x.sqrt };
    my &F = { (2 * $^x ** (3 / 2)) / 3 };
    my ($a, $b) = 2.7, 30;
    my $exact = &F($b) - &F($a);
    my $precision-goal = 5;

    my %res =
            nintegrate(&f, ['x', $a, $b],
                    method => ('LocalAdaptive', partitioning => 2, singularity-depth => Inf),
                    :$precision-goal,
                    min-recuraion => 4,
                    max-recursion => 9):pairs;

    is-approx %res<integral>, $exact,
            abs-tol => 5 * 10e0 ** (-$precision-goal), rel-tol => 5 * 10e0 ** (-$precision-goal),
            'integral estimate';

    #say (:$a, :$b, actual-error => %res<integral> - $exact);
    #say (:%res);
}, '1D, 1/sqrt(x) for [a,b] ranges';

done-testing;

use v6.d;
use Test;

use Math::NIntegrate;
use Math::NIntegrate::VariableTransformer::Composite;
use Math::NIntegrate::NumericalFunction;
use Math::NIntegrate::Rule::ClenshawCurtis;
use Math::NIntegrate::Rule::GaussKronrod;
use Math::NIntegrate::Rule::Trapezoidal;
use Math::NIntegrate::Rule::General;
use Math::NIntegrate::Region;
use Math::NIntegrate::Builder;
use Math::NIntegrate::Strategy;
use Math::NIntegrate::Strategy::GlobalAdaptive;

plan *;

## 1
subtest {

    # Integrand
    sub f($x) { 1 / $x.sqrt }
    my ($a, $b) = 1/2, 5;
    my $exact = - sqrt(2) + 2 * sqrt(5);

    my $working-precision = Rat;
    my $numerical-function = Math::NIntegrate::NumericalFunction.new(&f, :$working-precision);

    # Integration rule
    #my $rule = Math::NIntegrate::Rule::GaussKronrod.new(5);
    #my $rule = Math::NIntegrate::Rule::ClenshawCurtis.new(5, :$working-precision);
    my $rule = Math::NIntegrate::Rule::Trapezoidal.new(15, :$working-precision);

    # Region
    my $region = Math::NIntegrate::Builder.make-region($numerical-function, [$a,], [$b,], :$rule);

    # Strategy
    isa-ok Math::NIntegrate::Strategy::GlobalAdaptive.new(:0min-recursion, :5max-recursion, regions => [$region,]), Math::NIntegrate::Strategy, 'ok, strategy creation';

    my $strategy = Math::NIntegrate::Strategy::GlobalAdaptive.new(:0min-recursion, :5max-recursion, regions => [$region,]);

    # Integrate
    my $relative-tolerance = 1e-5;
    isa-ok $strategy.algorithm(:$relative-tolerance), Map:D, 'expected algorithm invocation result';

    my %res = $strategy.algorithm(:$relative-tolerance);

    #say (:%res);

    is (%res<integral> - $exact).abs ≤ $relative-tolerance * $exact, True, 'expected integral precision';

}, 'GlobalAdaptive, low-level invocation';

## 2
subtest {
    # Integrand
    sub f($x) { 1 / $x.sqrt }
    my ($a, $b) = 1/2, 5;

    my $working-precision = Rat;
    my $numerical-function = Math::NIntegrate::NumericalFunction.new(&f, :$working-precision);

    # Integration rule
    my $rule = Math::NIntegrate::Rule::Trapezoidal.new(15, :$working-precision);

    # Region
    my $region = Math::NIntegrate::Builder.make-region($numerical-function, [$a,], [$b,], :$rule);

    # Strategy
    my $strategy = Math::NIntegrate::Strategy::GlobalAdaptive.new(:0min-recursion, :5max-recursion, regions => [$region,]);

    # Integration monitor
    my @stats;
    my &integration-monitor = -> @regions {
        my $error = @regions>>.error.sum;
        my $integral = @regions>>.integral.sum;
        my %stat =
                region-count => @regions.elems,
                max-error => @regions>>.error.max,
                :$error,
                relative-error => $error.abs / ($integral.abs ?? $integral.abs !! 1),
                :$integral;
        @stats.push(%stat)
    };

    # Integrate
    my $relative-tolerance = 1e-5;

    my %res = $strategy.algorithm(:$relative-tolerance, :&integration-monitor);

    #.say for @stats;

    is @stats.all ~~ Map:D, True, 'stats are hashmaps';
    is @stats.elems ≥ 3, True, 'non-empty array of stats';
    is abs(@stats.tail<integral> - %res<integral>) ≤ 1e-12, True, 'expected last stat integral estimate';

    # Giving a wrong integration monitor is ok, just warnings are produced.
    ok $strategy.algorithm(:$relative-tolerance, integration-monitor => { ('duo:', $^a.elems, $^b.elems) } );

    my $res2 = $strategy.algorithm(:$relative-tolerance, integration-monitor => { ('duo:', $^a.elems, $^b.elems) } );
    isa-ok $res2, Map:D, 'expected result with wrong integration monitor';
    is ($res2<integral> - %res<integral>) ≤ 1e-14, True, 'expected integral estimate with wrong integration monitor';

}, 'Using integration monitor';

done-testing;

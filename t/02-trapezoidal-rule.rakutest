use v6.d;
use Test;

use Math::NIntegrate;
use Math::NIntegrate::Rule::Trapezoidal;

# 1
ok Math::NIntegrate::Rule::Trapezoidal.new(5);

# 2
subtest {
    ok Math::NIntegrate::Rule::Trapezoidal.new(5, Rat);

    my $rule = Math::NIntegrate::Rule::Trapezoidal.new(5, Rat);

    is $rule.abscissas.all ~~ Rat:D, True, 'all Rat abscissas';
    is $rule.weights.all ~~ Rat:D, True, 'all Rat weights';

}, 'Trapezoidal rule with Rat precision';

# 3
subtest {
    my $rule = Math::NIntegrate::Rule::Trapezoidal.new(5);

    # The undefined integral of &f is x^3/3 .
    my &f = {$_ ** 2};

    #say 'integral estimate : ', ($rule.abscissas».&f <<*>> $rule.weights).sum;
    #say '   error estimate : ', ($rule.abscissas».&f <<*>> $rule.error-weights).sum;

    # The defined integral over [0, 1] is 1/3 .
    is abs(($rule.abscissas».&f <<*>> $rule.weights).sum - 1/3) < 0.004, True, 'integral estimate';

    is ($rule.abscissas».&f <<*>> $rule.error-weights).sum.abs < 0.008, True, 'error estimate';

}, 'Trapezoidal integration, ad hoc';

# 4
subtest {
    isa-ok Math::NIntegrate::Rule::Trapezoidal.new(5, :!romberg), Math::NIntegrate::Rule, 'ok, creation with :!romberg';

    my $rule = Math::NIntegrate::Rule::Trapezoidal.new(5, :romberg-quadrature);

    is $rule.Hash<romberg-quadrature>:exists, True, 'representation has "romberg-quadrature" key';

    is $rule.Hash<romberg-quadrature>, True, '<romberg-quadrature> value';

    # Without Romberg integration weights this integral won't be computed precisely enough.
    # The undefined integral of &f is x^5/5 .
    my &f = { $_ ** 4 };

    #say 'integral estimate : ', ($rule.abscissas».&f <<*>> $rule.weights).sum;
    #say '   error estimate : ', ($rule.abscissas».&f <<*>> $rule.error-weights).sum;

    # The defined integral over [0, 1] is 1/5 .
    is abs(($rule.abscissas».&f <<*>> $rule.weights).sum - 1/5) < 0.004, True, 'integral estimate';

    is ($rule.abscissas».&f <<*>> $rule.error-weights).sum.abs < 0.008, True, 'error estimate';
}, 'TrapezoidalRule Romberg quadrature';

done-testing;

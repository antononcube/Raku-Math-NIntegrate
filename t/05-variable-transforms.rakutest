use v6.d;
use Test;

use Math::NIntegrate;
use Math::NIntegrate::VariableTransformer;
use Math::NIntegrate::VariableTransformer::Affine;
use Math::NIntegrate::VariableTransformer::Infinity;
use Math::NIntegrate::Region;

plan *;

## 1
subtest {
    my @ranges = ('x', 0, 1), ;

    ok Math::NIntegrate::Region.new(min => [0,], max => [1, ], dimension => 1);

}, 'Basic 1D region';

## 2
subtest {
    my $region1D = Math::NIntegrate::Region.new(min => [-2,], max => [5, ], dimension => 1);

    my %args =
            region => $region1D,
            min-original-bounds => 0,
            max-original-bounds => 1,
            min-transform-bounds => $region1D.min.head,
            max-transform-bounds => $region1D.max.head,
            working-precision => Rat
            ;

    ok Math::NIntegrate::VariableTransformer::Affine.new(|%args), 'Affine object creation is ok';

    my $vt = Math::NIntegrate::VariableTransformer::Affine.new(|%args);

    isa-ok $vt.transform(point => [1/3,], jacobian => 1), Map:D, 'method .transform returns Map:D';
    is-deeply $vt.transform(point => [1/3,], jacobian => 1).keys.sort, <jacobian point>, 'expected transform keys';

    dies-ok { $vt.transform(point => [1/3, 12/3], jacobian => 1) }, 'method .transform with 2D point';

    is-deeply
            $vt.transform(point => [1/3,], jacobian => 1),
            {point => [1/3,], jacobian => 7.0},
            'expected transform values';

    is-deeply
        $vt.transform(point => [2/3,], jacobian => 1),
        {point => [8/3], jacobian => 7.0},
        'expected transform values';

}, 'Affine';

## 3
#subtest {

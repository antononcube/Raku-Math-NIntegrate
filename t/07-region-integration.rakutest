use v6.d;
use Test;

use Math::NIntegrate;
use Math::NIntegrate::VariableTransformer::Composite;
use Math::NIntegrate::NumericalFunction;
use Math::NIntegrate::Rule::ClenshawCurtis;
use Math::NIntegrate::Rule::GaussKronrod;
use Math::NIntegrate::Rule::Trapezoidal;
use Math::NIntegrate::Rule::General;
use Math::NIntegrate::Region;
use Math::NIntegrate::Builder;

plan *;

## 1
subtest {
    # This is not how normally the integration region and its composite variable transformer are created.
    # They are normally created through the Builder class.
    # This test is to verify the low level creation of the objects:
    # integrand's numerical function, integration rule, integration region, variable transformer composite.

    # Integrand
    sub f($x) {$x ** 2}
    my $numerical-function = Math::NIntegrate::NumericalFunction.new(&f, working-precision => Rat);

    # Integration rule
    my $rule = Math::NIntegrate::Rule::GaussKronrod.new(5);

    # Region
    my $region = Math::NIntegrate::Region.new(min => [2,], max => [5, ], dimension => 1, :$numerical-function, :$rule);

    my %args =
            region => $region,
            min-original-bounds => 0,
            max-original-bounds => 1,
            min-transform-bounds => $region.min.head,
            max-transform-bounds => $region.max.head,
            working-precision => Rat
            ;

    ok Math::NIntegrate::VariableTransformer::Composite.new(|%args), 'Composite object creation is ok';

    my $vt = Math::NIntegrate::VariableTransformer::Composite.new(|%args);

    $region.variable-transformer = $vt;

    isa-ok $region.eval-integrand([0,]), Numeric:D, 'region eval-integrand call is ok';

    isa-ok $region.rule.integrate($region), Math::NIntegrate::Rule::General:D, 'region integration rule integrate';

    my $resRule = $region.rule.integrate($region);
    # say (integral => $resRule.integral, error => $resRule.error);
    is abs($resRule.integral - 39) ≤ 10e-6, True, 'expected integral estimate';
    is $resRule.error.abs ≤ 10e-5, True, 'expected error estimage';

}, 'Region integration, low-level';

## 2
subtest {

    # Integrand
    sub f($x) {$x ** 2}
    my $numerical-function = Math::NIntegrate::NumericalFunction.new(&f, working-precision => Rat);

    # Integration rule
    my $rule = Math::NIntegrate::Rule::GaussKronrod.new(5);

    # Region
    my $region = Math::NIntegrate::Builder.make-region(
            $numerical-function,
            [2,],
            [5, ],
            :$rule);

    isa-ok $region.eval-integrand([0,]), Numeric:D, 'region eval-integrand call is ok';

    isa-ok $region.rule.integrate($region), Math::NIntegrate::Rule::General:D, 'region integration rule integrate';

    my $resRule = $region.rule.integrate($region);
    # say (integral => $resRule.integral, error => $resRule.error);
    is abs($resRule.integral - 39) ≤ 1e-5, True, 'expected integral estimate';
    is $resRule.error.abs ≤ 1e-4, True, 'expected error estimate';

}, 'Region integration, Builder creation';


## 3
subtest {

    # Integrand
    sub f($x) { 1 / $x.sqrt }
    my $numerical-function = Math::NIntegrate::NumericalFunction.new(&f, working-precision => Rat);

    # Integration rule
    my $rule = Math::NIntegrate::Rule::GaussKronrod.new(3);

    # Region
    my $region = Math::NIntegrate::Builder.make-region(
            $numerical-function,
            [0.5,],
            [5, ],
            :$rule);

    isa-ok $region.eval-integrand([0,]), Numeric:D, 'region eval-integrand call is ok';

    isa-ok $region.rule.integrate($region), Math::NIntegrate::Rule::General:D, 'region integration rule integrate';

    my $exact = - sqrt(2) + 2 * sqrt(5);
    my $resRule = $region.rule.integrate($region);
    # say (integral => $resRule.integral, error => $resRule.error);
    is abs($resRule.integral - $exact) > 1e-5, True, 'expected integral estimate';
    is $resRule.error.abs > 1e-2, True, 'expected error estimate';

    # Cloning tests
    isa-ok $region.clone, Math::NIntegrate::Region:D, 'region clone call ok';
    my $region-clone = $region.clone;
    is-deeply $region-clone.min, $region.min, 'clone has the same min boundaries';
    is-deeply $region-clone.max, $region.max, 'clone has the same max boundaries';

    # Split the clone
    isa-ok $region-clone.split(:0axis), Math::NIntegrate::Region:D, 'expected result type for region splitting';

    # Split original region
    my $region2 = $region.split(:0axis);

    # Boundaries after the split
    is $region.variable-transformer.get-transform-bounds<min>[0], 0.5, 'expected min boundary of old region';
    is $region.variable-transformer.get-transform-bounds<max>[0], 2.75, 'expected max boundary of old region';

    is $region2.variable-transformer.get-transform-bounds<min>[0], 2.75, 'expected min boundary of new region';
    is $region2.variable-transformer.get-transform-bounds<max>[0], 5, 'expected max boundary of new region';

    is $region.levels, 1, 'expected level';
    is $region2.levels, 1, 'expected level';

    my $res1 = $region.rule.integrate($region);
    my $res2 = $region2.rule.integrate($region2);
    # say (integral1 => $res1.integral, integral2 => $res2.integral);
    # say (error1 => $res1.error, error2 => $res2.error);
    is ($res1.integral + $res2.integral - $exact) ≤ 1e-5, True, 'improved estimate';
    is ($res1.error + $res2.error).abs ≤ 4e-2, True, 'smaller error';

}, 'Region split and integration';


## 4
subtest {

    # Integrand
    sub f($x) {exp(- $x ** 2)}
    my $numerical-function = Math::NIntegrate::NumericalFunction.new(&f, working-precision => Rat);

    # Exact value
    my $exact = π.sqrt / 2; # 0.886227

    # Integration rule
    #my $rule = Math::NIntegrate::Rule::Trapezoidal.new(15);
    my $rule = Math::NIntegrate::Rule::ClenshawCurtis.new(9);

    # Region
    my $region = Math::NIntegrate::Builder.make-region(
            $numerical-function,
            [0,],
            [Inf, ],
            :$rule);

    isa-ok $region.eval-integrand([0,]), Numeric:D, 'region eval-integrand call is ok';

    isa-ok $region.apply-rule, Math::NIntegrate::Region:D, 'region integration rule integrate';

    $region.apply-rule;
    # say (integral => $region.integral, error => $region.error);
    is abs($region.integral - $exact) ≤ 1e-3, True, 'expected integral estimate';
    is $region.error.abs ≤ 1e-3, True, 'expected error estimate';

    # Region
    my $region2 = Math::NIntegrate::Builder.make-region(
            $numerical-function,
            [-Inf,],
            [0, ],
            :$rule);

    $region2.apply-rule;
    #say abs($region2.integral - $region.integral);
    is abs($region2.integral - $region.integral) ≤ 1e-10, True, '[-Inf, 0] and [0, Inf] integral estimates are almost the same';

}, 'Infinite region integration';

done-testing;

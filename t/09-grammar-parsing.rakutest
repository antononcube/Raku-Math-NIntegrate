use v6.d;
use Test;

use Math::NIntegrate;
use Math::NIntegrate::Processing::Grammar;

my $gr = Math::NIntegrate::Processing::Grammar.new;

# 1
subtest {
    my @specs =
            'GlobalAdaptive',
            'global-adaptive',
            'local_adaptive',
            'monte-carlo',
            'quasi-monte-carlo'
            ;
    for @specs.kv -> $i, $spec {
        ok $gr.parse($spec, rule => 'strategy-symbol-known'), "failed strategy name $i : ⎡$spec⎦";
    }

}, 'known strategy names';

# 1
subtest {
    my @specs =
            'GaussKronrodRule',
            'gauss-kronrod-rule',
            'clenshaw-curtis-rule',
            'monte-carlo-rule',
            'lobatto_kronrod_rule'
            ;
    for @specs.kv -> $i, $spec {
        ok $gr.parse($spec, rule => 'rule-symbol-known'), "failed rule name $i : ⎡$spec⎦";
    }

}, 'known rule names';

# 3
subtest {
    my @specs =
            'method => GlobalAdaptive',
            'method => ( GlobalAdaptive )',
            'method => (GlobalAdaptive, method => ClenshawCurtisRule)',
            'method => (GlobalAdaptive, max-recursion => 10, singulity-depth => 4)',
            'method => (GlobalAdaptive, method => (TrapezoidalRule, points => 5))',
            'method => (GlobalAdaptive, method => (TrapezoidalRule, :10points))',
            'method => (GlobalAdaptive, method => (TrapezoidalRule, :10points), max-recursion => 20)',
            'method => (GlobalAdaptive, method => (CartesianRule, method => (TrapezoidalRule, :10points), max-recursion => 20))',
    ;
    for @specs.kv -> $i, $spec {
        ok $gr.parse($spec), "failed strategy method spec $i : ⎡$spec⎦";
    }

}, 'strategy method specs';


done-testing;

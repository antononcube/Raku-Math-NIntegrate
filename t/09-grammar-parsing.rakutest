use v6.d;
use Test;

use Math::NIntegrate;
use Math::NIntegrate::Processing::Grammar;

my $gr = Math::NIntegrate::Processing::Grammar.new;

# 1
subtest {
    my @specs =
            'GlobalAdaptive',
            'global-adaptive',
            'local_adaptive',
            'monte-carlo',
            'quasi-monte-carlo'
            ;
    for @specs.kv -> $i, $spec {
        ok $gr.parse($spec, rule => 'strategy-symbol-known'), "failed strategy name $i : ⎡$spec⎦";
    }

    # Quoted
    @specs =
            '"GlobalAdaptive"',
            '"global-adaptive"',
            ;
    for @specs.kv -> $i, $spec {
        ok $gr.parse($spec, rule => 'strategy-symbol'), "failed strategy name $i : ⎡$spec⎦";
    }

}, 'known strategy names';

# 2
subtest {
    my @specs =
            'GaussKronrodRule',
            'clenshaw-curtis-rule',
            'gauss-kronrod-rule',
            'lobatto_kronrod_rule',
            'monte-carlo-rule',
            'multidimensional-rule',
            'newton_cotes-rule',
            ;
    for @specs.kv -> $i, $spec {
        ok $gr.parse($spec, rule => 'rule-symbol-known'), "failed rule name $i : ⎡$spec⎦";
    }

}, 'known rule names';

# 3
subtest {
    my @specs =
            'GlobalAdaptive',
            '( GlobalAdaptive )',
            '(GlobalAdaptive, method => ClenshawCurtisRule)',
            '(GlobalAdaptive, max-recursion => 10, singularity-depth => 4)',
            '(MonteCarlo, partitioning => 4)',
            '(MonteCarlo, :10partitioning)',
            '(MonteCarlo, partitioning => (4, 3))',
            '(GlobalAdaptive, method => (TrapezoidalRule, points => 5))',
            '(GlobalAdaptive, method => (MultiDimensionalRule, generators => 7))',
            '(GlobalAdaptive, method => (TrapezoidalRule, :10points))',
            '(GlobalAdaptive, method => (TrapezoidalRule, :10points), max-recursion => 20)',
            '(global-adaptive, method => Whatever, singularity-handler => Whatever)',
            '(GlobalAdaptive, method => (TrapezoidalRule, :10points), max-recursion => 20, singularity-handler => IMT)',
            '(GlobalAdaptive, method => (CartesianRule, method => (TrapezoidalRule, :10points), max-recursion => 20))',
            ;
    for @specs.kv -> $i, $spec {
        ok $gr.parse($spec, rule => 'strategy-spec'), "failed GlobalAdaptive spec $i : ⎡$spec⎦";
    }

}, 'Strategy specs';

# 4
subtest {
    ok
            $gr.parse('((TrapezoidalRule, :10points), (GaussKronrodRule, :10points))', rule => 'rule-component-option-value'),
            'rule component option value';

    ok
           $gr.parse('(("TrapezoidalRule", :points(5)), ("GaussKronrodRule", :points(10)))', rule => 'rule-component-option-value'),
           'rule component option with quotes';
    ok
            $gr.parse(':method((("TrapezoidalRule", :points(5)), ("GaussKronrodRule", :points(10))))', rule => 'cartesian-rule-method'),
            'cartesian-rule-method';

    my @specs =
            'CartesianRule',
            '"CartesianRule"',
            '( CartesianRule )',
            '(CartesianRule, method => ClenshawCurtisRule)',
            '(CartesianRule, method => (TrapezoidalRule, points => 5))',
            '(CartesianRule, method => (TrapezoidalRule, :10points))',
            '(CartesianRule, method => ((TrapezoidalRule, :10points), (GaussKronrodRule, :10points)) )',
            '("CartesianRule", method => ("ClenshawCurtisRule", :points(5)))',
            '("CartesianRule", :method(("ClenshawCurtisRule", :points(5))))',
            '("CartesianRule", method => (("TrapezoidalRule", :points(5)), ("ClenshawCurtisRule", :points(5))))',
            '("CartesianRule", :method((("TrapezoidalRule", :points(5)), ("ClenshawCurtisRule", :points(5)))))'
            ;
    for @specs.kv -> $i, $spec {
        ok $gr.parse($spec, rule => 'cartesian-rule-spec'), "failed CartesianRule spec $i : ⎡$spec⎦";
    }

    my $spec = '(GlobalAdaptive, method => (CartesianRule, method => (TrapezoidalRule, :10points), max-recursion => 20))';
    nok $gr.parse($spec, rule => 'cartesian-rule-spec'), 'nested Cartesian rule specs are nok';

}, 'Cartesian rule specs';

# 5
subtest {
    my @specs =
            'method => GlobalAdaptive',
            'method => ( GlobalAdaptive )',
            'method => (GlobalAdaptive, method => (TrapezoidalRule, points => 5))',
            'method => (global-adaptive, singularity-handler => none)',
            'method => (global-adaptive, singularity-handler => "none")',
            'method => (GlobalAdaptive, method => (CartesianRule, method => (TrapezoidalRule, :10points), max-recursion => 20))',
            # Note that nested Cartesian rule is parsed
            'method => (GlobalAdaptive, method => (CartesianRule, method => (CartesianRule, method => (TrapezoidalRule, :10points))), max-recursion => 20)',
    ;
    for @specs.kv -> $i, $spec {
        ok $gr.parse($spec, rule => 'method-option'), "failed method spec $i : ⎡$spec⎦";
    }

}, 'generic, correct syntax parser';

# 6
subtest {
    grammar WLStyle is Math::NIntegrate::Processing::Grammar {
        token lb {'{'}
        token rb {'}'}
        token arrow {'->'}
    }

    my $gr = WLStyle.new;

    my @specs =
            'GlobalAdaptive',
            '{ GlobalAdaptive }',
            '{GlobalAdaptive, Method -> ClenshawCurtisRule}',
            '{GlobalAdaptive, MaxRecursion -> 10, SingularityDepth -> 4}',
            '{GlobalAdaptive, Method -> {TrapezoidalRule, Points -> 5}}',
            '{GlobalAdaptive, Method -> {TrapezoidalRule, Points -> 5}}',
            '{GlobalAdaptive, Method -> {TrapezoidalRule, Points -> 10}, max-recursion -> 20}',
            '{GlobalAdaptive, Method -> {CartesianRule, Method -> {TrapezoidalRule, Points -> 10}, MaxRecursion -> 20}}',
            ;
    for @specs.kv -> $i, $spec {
        ok $gr.parse($spec, rule => 'strategy-spec'), "failed WL GlobalAdaptive spec $i : ⎡$spec⎦";
    }

}, 'Strategy specs: Wolfram Language syntax';


# 7
subtest {

    ok $gr.subparse('"GlobalAdaptive"', rule => 'strategy-spec');
    ok $gr.subparse('"ClenshawCurtisRule"', rule => 'rule-spec');
    ok $gr.subparse('("ClenshawCurtisRule", :points(6))', rule => 'rule-spec');
    ok $gr.subparse('("ClenshawCurtisRule", :points(6))', rule => 'method-option-value');
    ok $gr.subparse('("ClenshawCurtisRule", points => 6)', rule => 'method-option-value');
    ok $gr.subparse(':method(("ClenshawCurtisRule", :points(6)))', rule => 'method-option');
    ok $gr.subparse('("GlobalAdaptive", :method(("ClenshawCurtisRule", :points(6))))', rule => 'strategy-spec');

}, '.raku forms';

# 8
subtest {
    my @specs =
            'UnitCubeRescaling',
            '( UnitCubeRescaling )',
            '(UnitCubeRescaling, method => ClenshawCurtisRule)',
            '(UnitCubeRescaling, method => GlobalAdaptive)',
            '(UnitCubeRescaling, method => (GlobalAdaptive, max-recursion => 10, singularity-depth => 4))'
            ;
    for @specs.kv -> $i, $spec {
        ok $gr.parse($spec, rule => 'strategy-decorator-spec'), "failed UnitCubeRescaling spec $i : ⎡$spec⎦";
    }

}, 'Strategy decorator specs';

done-testing;

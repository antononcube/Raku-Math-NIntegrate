use v6.d;
use Test;

use Math::NIntegrate;
use Math::NIntegrate::Rule::GaussKronrod;
use Math::NIntegrate::Strategy::GlobalAdaptive;

class CustomRule is Math::NIntegrate::Rule::GaussKronrod {

};

class CustomStrategy is Math::NIntegrate::Strategy::GlobalAdaptive {

};

my $gr = Math::NIntegrate::Processing::Grammar.new;
my $actions = Math::NIntegrate::Processing::Actions::MethodSpec.new;

subtest {
        my @specs =
                'CustomRule',
                'CustomStrategy',
                ;

        for @specs.kv -> $i, $spec {
                ok $gr.parse($spec, rule => 'TOP'), "failed spec $i : ⎡$spec⎦";
        }
}, 'User defined by descendents pass parsing';

subtest {
        class CustomRule2 {
                has @.abcsissas
        }

        my @specs2 =
                'CustomRuler',
                'CustomRule2',
                'CustomStrateger',
                ;

        for @specs2.kv -> $i, $spec {
                nok $gr.parse($spec, rule => 'TOP'), "failed to fail spec $i : ⎡$spec⎦";
        }
}, 'User defined generic does not pass parsing';

subtest {
        my %res1 = nintegrate({ $^x }, <x 0 1>, method => 'CustomRule', :4precision-goal):pairs;
        is-approx %res1<integral>, 1 / 2, 'expected 1D integral value';

        my %res2 = nintegrate({ $^x + $^y }, <x 0 1>, <y 0 1>, method => 'CustomRule'):pairs;
        is-approx %res2<integral>, 1, 'expected 2D integral value';

        my %res3 = nintegrate({ $^x + $^y }, <x 0 1>, <y 0 1>,
                method => ('local-adaptive', method => 'CustomRule')):pairs;
        is-approx %res3<integral>, 1, 'expected 2D integral value, local-adative';

}, 'Integrals computation with a user rule';

done-testing;

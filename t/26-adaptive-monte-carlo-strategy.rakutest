use v6.d;
use Test;

use Math::NIntegrate;

## 1
subtest {
     isa-ok
                nintegrate({ $^x }, <x 0 1>,
                        method => ('AdaptiveMonteCarlo',
                                   method => ('MonteCarloRule', points => 1_000),
                                   bisection-dithering => -0.1,
                                   partitioning => 3,
                                   random-seed => 323),
                        precision-goal => 2),
                Numeric:D,
                '1D integral gives a numeric result';

     is-approx
             nintegrate({ 1 / (1 + $^x ** 2) }, <x 1 10>,
                     method => 'adaptive-monte-carlo', :2precision-goal),
             0.68572951090628628224,
             rel-tol => 10e-2,
             '-(Pi/4) + ArcTan[10]'

}, '1D integrals';

## 2
subtest {

        is-approx
                nintegrate({ exp(-($^x ** 4 + $^y **4)) }, ['x', -π, π], ['y', -π, π],
                        method => ('adaptive-monte-carlo', method => 'monte-carlo-rule'), :2precision-goal),
                3.2862618016492186032,
                rel-tol => 10e-2,
        'expected value'
        
}, '2D integrals';

done-testing;

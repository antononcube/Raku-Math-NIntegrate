use v6.d;
use Test;

use Math::NIntegrate;
use Math::NIntegrate::Rule::Cartesian;
use Math::NIntegrate::Rule::ClenshawCurtis;
use Math::NIntegrate::Rule::Trapezoidal;

## 1
subtest {
    isa-ok
            Math::NIntegrate::Rule::Cartesian.new(components => [], :3dimension),
            Math::NIntegrate::Rule::Cartesian:D,
            'creation with empty array and positive integer for dimension is ok';

    dies-ok
            { Math::NIntegrate::Rule::Cartesian.new(components => [], :0dimension) },
            'creation with 0 dimension dies';

    my @components = Math::NIntegrate::Rule::ClenshawCurtis.new(5), Math::NIntegrate::Rule::Trapezoidal.new(3);

    isa-ok
            Math::NIntegrate::Rule::Cartesian.new(:@components, :3dimension),
            Math::NIntegrate::Rule::Cartesian:D,
            'creation with 2 components and dimension 3 is ok';

    dies-ok
            {Math::NIntegrate::Rule::Cartesian.new(:@components, :1dimension)},
            'creation with 2 components and dimension 1 dies';

    isa-ok
            Math::NIntegrate::Rule::Cartesian.new(:@components, dimension => Whatever),
            Math::NIntegrate::Rule::Cartesian:D,
            'creation with 2 components and dimension Whatever is ok';

}, 'creations';

## 2
subtest {
    my @components = Math::NIntegrate::Rule::ClenshawCurtis.new(5);
    my $rule = Math::NIntegrate::Rule::Cartesian.new(:@components, :2dimension);

    # The undefined integral of &f is (x^2 y)/2 + (x y^3)/3.
    # The exact value in [0, 1] x [0, 1] is 5/6.
    my &f = {$^a + $^b ** 2};

    $rule.make-rule-data();
    #say 'integral estimate : ', ($rule.abscissas.map({ &f(|$_) }) <<*>> $rule.weights).sum;
    #say '   error estimate : ', ($rule.abscissas.map({ &f(|$_) }) <<*>> $rule.error-weights).sum;

    is abs(($rule.abscissas.map({ &f(|$_) }) <<*>> $rule.weights).sum - 5/6) < 10e-9, True, 'integral estimate';

    is ($rule.abscissas.map({ &f(|$_) }) <<*>> $rule.error-weights).sum.abs < 10e-5, True, 'error estimate';

}, 'integral estimates';

done-testing;

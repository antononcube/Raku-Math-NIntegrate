use v6.d;
use Test;

use Math::NIntegrate;
use Math::NIntegrate::Rule::GaussKronrod;

# 1
subtest {
    ok Math::NIntegrate::Rule::GaussKronrod.new(5), 'ok to create with 5 points';
    ok Math::NIntegrate::Rule::GaussKronrod.new(11, working-precision => Rat), 'ok to create with 11 points and working precision Rat';
    ok Math::NIntegrate::Rule::GaussKronrod.new(8, prec => Rat), 'ok to create with 8 points and prec Rat';
}, 'Gauss-Kronrod rule creations';

# 2
subtest {
    my $rule = Math::NIntegrate::Rule::GaussKronrod.new(5);

    # The undefined integral of &f is x^3/3 .
    my &f = {$_ ** 2};

    say 'integral estimate : ', ($rule.abscissas».&f <<*>> $rule.weights).sum;
    say '   error estimate : ', ($rule.abscissas».&f <<*>> $rule.error-weights).sum;

    # The defined integral over [0, 1] is 1/3 .
    is abs(($rule.abscissas».&f <<*>> $rule.weights).sum - 1/3) < 10e-7, True, 'integral estimate';

    is ($rule.abscissas».&f <<*>> $rule.error-weights).sum.abs < 10e-7, True, 'error estimate';
}, 'Gauss-Kronrod integration, ad hoc';

done-testing;

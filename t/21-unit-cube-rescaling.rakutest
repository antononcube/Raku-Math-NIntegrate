use v6.d;
use Test;

use Math::NIntegrate;

# 1
subtest {
    my &f = {$^x + $^y ** 2};
    # The undefined integral of &f is (x^2 y)/2 + (x y^3)/3.
    # The exact value in [0, 1] x [0, 1] is 5/6.
    # The exact value in [0, 3] x [0, 5] is 295/2.
    my $exact = 295/2;

   isa-ok
           nintegrate(&f, ('x', 0, 3), ('y', 0, 5),
                   method => ('UnitCubeRescaling', method => 'MultiDimensionalRule'),
                   max-recursion => 3),
           Numeric:D,
           'ok to call';

    my %res = nintegrate(&f, ('x', 0, 3), ('y', 0, 5),
            method => 'UnitCubeRescaling',
            max-recursion => 3):pairs;

    # Num
    is abs(%res<integral> - $exact) ≤ 1e-6, True, 'expected Num result';

}, 'UnitCubeRescaling for 2D constant ranges region';


done-testing;

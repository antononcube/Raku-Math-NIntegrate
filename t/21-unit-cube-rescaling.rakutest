use v6.d;
use Test;

use Math::NIntegrate;
use Math::NIntegrate::Strategy::UnitCubeRescaling;


# 1
subtest {
    my &f = { 1 / ($^x ** 2 + $^y ** 2) };
    my @ranges = <x 1 Inf>, <y Inf -Inf>;

    my $strategy = Math::NIntegrate::Strategy::GlobalAdaptive.new();
    my $decorator = Math::NIntegrate::Strategy::UnitCubeRescaling.new($strategy);

    isa-ok
            $decorator.ranges-to-cube(&f, @ranges),
            Map:D,
            'ok to call ranges-to-cube';

    my %res = $decorator.ranges-to-cube(&f, @ranges);

    is-deeply %res<ranges>, ([0, 1] xx @ranges.elems).Array, 'expected ranges';

    isa-ok %res<integrand>(0.3, 1000), Numeric:D, 'expected numerical result from the new integrand';

    my %res2 = $decorator.ranges-to-cube(&f, @ranges):!eval;

    isa-ok %res2<integrand>, Str:D, 'expected string result for the new integrand';

}, 'Recaling';


# 2
subtest {
    my &f = {$^x + $^y ** 2};
    # The undefined integral of &f is (x^2 y)/2 + (x y^3)/3.
    # The exact value in [0, 1] x [0, 1] is 5/6.
    # The exact value in [0, 3] x [0, 5] is 295/2.
    my $exact = 295/2;

   isa-ok
           nintegrate(&f, ('x', 0, 3), ('y', 0, 5),
                   method => ('UnitCubeRescaling', method => 'MultiDimensionalRule'),
                   max-recursion => 3),
           Numeric:D,
           'ok to call';

    my %res = nintegrate(&f, ('x', 0, 3), ('y', 0, 5),
            method => 'UnitCubeRescaling',
            max-recursion => 3):pairs;

    is-approx %res<integral>, $exact, 'expected finite integral result';

    is-approx
            nintegrate({1/($^x ** 2 + $^y ** 2)}, <x 1 Inf>, <y 0 1>, method => 'UnitCubeRescaling'),
            0.91596559417721901505,
            'Catalan constant, <x 1 Inf>, <y 0 1>';

    # The exact result is 1/2 * Pi * Erfc(2)
    is-approx
            nintegrate({exp(-($^x ** 2 + $^y ** 2))}, <x -Inf Inf>, <y 2 Inf>, method => 'UnitCubeRescaling'),
            0.0073477689259490405327,
            'π Erfc(2), <x -Inf Inf>, <y 2 Inf>';

}, 'UnitCubeRescaling for 2D constant ranges region';

done-testing;

use v6.d;
use Test;

use Math::NIntegrate;

## 1
subtest {
        isa-ok
                nintegrate({ $^x }, <x 0 1>,
                        method => ('MonteCarlo', method => ('MonteCarloRule', points => 1_000)),
                        precision-goal => 2),
                Numeric:D,
                '1D integral gives a numeric result';

        isa-ok
                nintegrate({ $^x }, <x 0 1>,
                        method => ('MonteCarlo', method => ('MonteCarloRule', points => 1_000), partitioning => 3,
                                   random-seed => 323),
                        precision-goal => 2),
                Numeric:D,
                '1D integral gives a numeric result';
}, 'MonteCarlo 1D integrals';

## 2
subtest {

        isa-ok
                nintegrate({ exp(-($^x ** 4 + $^y ** 4)) }, <x -2 2>, <y -2 2>,
                        method => ('MonteCarlo', method => ('MonteCarloRule', points => 100), partitioning => 3,
                                   random-seed => 11343),
                        min-recurion => 2,
                        max-points => 1_000,
                        precision-goal => 3.1),
                Numeric:D,
                '2D integral gives a numeric result';
        
}, 'MonteCarlo 2D integrals';

## 3
subtest {

    isa-ok
        nintegrate({ $^x }, <x 0 1>, method => 'QuasiMonteCarlo'),
        Numeric:D,
        '1D integral gives a numeric result, simple spec';

    isa-ok
            nintegrate({ $^x }, <x 0 1>,
                    method => ('QuasiMonteCarlo', method => ('MonteCarloRule', points => 1_000, point-generator => 'halton')),
                    precision-goal => 2),
            Numeric:D,
            '1D integral gives a numeric result';

    # This command is/should give the warning:
    # > The value of $random-seed is ignored by the QuasiMonteCarlo strategy.
    # How to test that MonteCarloRule does one of low-discrepancy point generators?
    isa-ok
            nintegrate({ $^x }, <x 0 1>,
                    method => ('QuasiMonteCarlo', method => ('MonteCarloRule', points => 1_000),
                               partitioning => 3, random-seed => 323),
                    precision-goal => 2),
            Numeric:D,
            '1D integral gives a numeric result';
}, 'QuasiMonteCarlo 1D integrals';

## 4
subtest {

    isa-ok
            nintegrate({ exp(-($^x ** 4 + $^y ** 4)) }, <x -2 2>, <y -2 2>,
                    method => ('QuasiMonteCarlo', method => ('MonteCarloRule', points => 100), partitioning => 3),
                    min-recurion => 2,
                    max-points => 1_000,
                    precision-goal => 3.1),
            Numeric:D,
            '2D integral gives a numeric result';

}, 'QuasiMonteCarlo 2D integrals';

done-testing;

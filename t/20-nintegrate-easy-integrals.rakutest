use v6.d;
use Test;

use Math::NIntegrate;
use Math::NIntegrate::NumericalFunction;

# 1
subtest {
    sub f(Numeric:D $x) {$x};
    ok nintegrate(&f, ('x', 0, 1)), 'ok to call';

    isa-ok nintegrate(&f, <x 0 1>), Numeric:D, 'Numeric result for the call <x 0 1>';

    # Num
    is abs(nintegrate(&f, ('x', 0, 3)) - 9/2) ≤ 1e-6, True, 'expected Num result';

    # Rat
    ok
            nintegrate(&f, ('x', 0, 3),
                    working-precision => Rat,
                    precision-goal => 8,
                    method => 'trapezoidal-rule'),
            'ok Rat working precision';

    my $res =
            nintegrate(&f, ('x', 0, 3),
                    working-precision => Rat,
                    precision-goal => 8,
                    method => 'trapezoidal-rule');

    is abs($res - 9/2) ≤ 1e-10, True, 'expected Rat result';

}, 'nintegrate(&f, (x, 0, 3))';


# 2
subtest {
    #sub f($x) {exp(- $x ** 2)}
    my &f = {exp(- $^x ** 2)}

    my $exact = π.sqrt / 2; # 0.886227

    is abs(nintegrate(&f, ('x', 0, Inf)) - $exact) ≤ 1e-6, True, 'expected Num result';

    # Rat
    my $res =
            nintegrate(&f, ('x', 0, Inf),
                    working-precision => Rat,
                    precision-goal => 8,
                    method => 'ClenshawCurtisRule'):pairs;

    isa-ok $res, Map:D, 'obtained hashmap with :pairs';

    is ($res.keys (&) <error integral region-count>).elems, 3, 'exected keys';

    is abs($res<integral> - $exact) ≤ 1e-12, True, 'expected Rat result';

}, 'nintegrate( { exp(- $^x ** 2) }, (x, 0, Inf))';


# 3
subtest {
    my &f = {$^x + $^y ** 2};
    # The undefined integral of &f is (x^2 y)/2 + (x y^3)/3.
    # The exact value in [0, 1] x [0, 1] is 5/6.
    # The exact value in [0, 3] x [0, 5] is 295/2.
    my $exact = 295/2;

    ok nintegrate(&f, ('x', 0, 1), ('y', 0, 1)), 'ok to call';

    # Num
    is abs(nintegrate(&f, ('x', 0, 3), ('y', 0, 5)) - $exact) ≤ 1e-6, True, 'expected Num result';

    # Rat
    ok
            nintegrate(&f, ('x', 0, 3), ('y', 0, 5),
                    working-precision => Rat,
                    precision-goal => 8,
                    method => 'clenshaw-curtis-rule'),
            'ok Rat working precision';

    my $res =
            nintegrate(&f, ('x', 0, 3), ('y', 0, 5),
                    working-precision => Rat,
                    precision-goal => 8,
                    method => 'clenshaw-curtis-rule');
    #say (:$res);
    is abs($res - $exact) ≤ 1e-10, True, 'expected Rat result';

}, 'nintegrate( { $^x + $^y ** 2 }, (x, 0, 3), (y, 0, 5))';


# 4
subtest {
    isa-ok
            nintegrate( -> $x, $y { $x + $y² }, <x 0 2>, <y 0 12>, method => ('GlobalAdaptive', method => 'TrapezoidalRule')),
            Numeric:D,
            "method => ('GlobalAdaptive', method => 'TrapezoidalRule')";

    isa-ok
            nintegrate( -> $x, $y { $x + $y² }, <x 0 2>, <y 0 12>, method => ('GlobalAdaptive', method => ('TrapezoidalRule', points => 10))),
            Numeric:D,
            "method => ('GlobalAdaptive', method => ('TrapezoidalRule', points => 5))"

}, 'Nested method options';

# 5
subtest {
    isa-ok
            nintegrate( -> $x, $y { $x + $y² }, <x 0 2>, <y 0 12>, min-recursion => 2),
            Numeric:D,
            "min-recursion spec gives Numeric:D result";

    my %res = nintegrate( -> $x, $y { $x + $y² }, <x 0 2>, <y 0 12>, min-recursion => 2):pairs;

    is %res<region-count> == 16, True, "expected number of 2D regions";

    # This is slow ≈10 s
    # my %res3D = nintegrate( -> $x, $y, $z { $x + $y + $z }, <x 0 1>, <y 0 1>, <z 0 1>, min-recursion => 2):pairs;
    # is %res3D<region-count> == 64, True, "expected number of 3D regions";

    my %res3D = nintegrate( -> $x, $y, $z { $x + $y + $z }, <x 0 1>, <y 0 1>, <z 0 1>, min-recursion => 1):pairs;
    is %res3D<region-count> == 8, True, "expected number of 3D regions";

}, 'Min-recursion';

done-testing;

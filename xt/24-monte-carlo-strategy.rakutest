use v6.d;
use Test;

use Math::NIntegrate;

# Currently MonteCarlo is slow -- most likely because of MonteCarlo rule.

subtest {
        isa-ok
                nintegrate({ $^x }, <x 0 1>,
                        method => ('MonteCarlo', method => ('MonteCarloRule', points => 1_000)),
                        precision-goal => 2),
                Numeric:D,
                '1D integral gives a numeric result';

        isa-ok
                nintegrate({ $^x }, <x 0 1>,
                        method => ('MonteCarlo', method => ('MonteCarloRule', points => 1_000), partitioning => 3,
                                   random-seed => 323),
                        precision-goal => 2),
                Numeric:D,
                '1D integral gives a numeric result';
}, '1D integrals';

subtest {

        isa-ok
                nintegrate({ exp(-($^x ** 4 + $^y ** 4)) }, <x -2 2>, <y -2 2>,
                        method => ('MonteCarlo', method => ('MonteCarloRule', points => 300), partitioning => 3,
                                   random-seed => 11343),
                        min-recurion => 2,
                        precision-goal => 1.1),
                Numeric:D,
                '2D integral gives a numeric result';
        
}, '2D integrals';

done-testing;

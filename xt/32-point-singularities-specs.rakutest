use v6.d;
use Test;

use Math::NIntegrate;

# 1
subtest {
    # ≈ 7.05099
    my $exact = 8 * asinh(1);

    #my %res = nintegrate({1/($^x ** 2 + $^y ** 2).sqrt}, <x -1 0 1>, <y -1 0 1>):pairs;

    my %res =
            nintegrate(
                    { 1 / ($^x ** 2 + $^y ** 2).sqrt },
                    <x -1 0 1>, <y -1 0 1>,
                    method => ('global-adaptive', singularity-depth => 4),
                    min-recursion => 0, method => 'gauss-kronrod-rule', max-recursion => 8,
                    :6precision-goal
                                        ):pairs;

    is-approx %res<integral>, $exact;
}, '1 / sqrt(x^2 + y^2)';

# 2
subtest {
    # Without the singular points spec the errors is too large.
    # Note the terms i*0 have to be added in order to have complex number computations.
    my $exact = - π*i;
    my %res =
            nintegrate(
                    { 1 / sqrt($^x - π / 6 + i*0) * 1 / sqrt($^x - π / 3 + i*0) },
                    ['x', 0, π / 6, π / 3, π / 2],
                    method => ('global-adaptive', singularity-depth => 4),
                    min-recursion => 0, max-recursion => 10,
                    :6precision-goal
                                        ):pairs;
    #say %res;
    is-approx %res<integral>, $exact;
}, '1/sqrt(x - π/6) * 1/sqrt(x - π/3), complex integral value';

# 3
subtest {
    # Without the singular points spec the errors is too large.

    # ≈ -2.94423
    my $exact = 2 * (-6 + π + log(4));

    my %res =
            nintegrate(
                    { log( (1 - $^x) ** 2 + (1 - $^y) ** 2) },
                    ['x', 0, 1, 2], ['y', 0, 1, 2],
                    method => ('global-adaptive', method => 'gauss-kronrod-rule', singularity-depth => Inf),
                    min-recursion => 0, max-recursion => 10,
                    :6precision-goal
                                            ):pairs;
    #say %res;
    is-approx %res<integral>, $exact;
}, 'log( (1-x)^2 + (1-y)^2 )';

# 4
subtest {
    my $exact = 4;
    my %res = nintegrate({ 1 / ($^x - 1).abs.sqrt }, ('x', 0, 1, 2), :7precision-goal):pairs;
    #say (:%res);
    is-approx %res<integral>, $exact;
}, '1/sqrt(abs(x-1))';

done-testing;

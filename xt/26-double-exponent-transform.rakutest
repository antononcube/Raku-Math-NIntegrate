use Test;

use Math::NIntegrate;
use Math::NIntegrate::VariableTransformer::DoubleExponential;

# 1
subtest {
        my $region = Math::NIntegrate::Region.new(min => [-2, 4], max => [5, 10], dimension => 2);

        my @min-original-bounds = -2, 5;
        my @max-original-bounds = 4, 10;
        my @min-transform-bounds = 0 xx $region.dimension;
        my @max-transform-bounds = 1 xx $region.dimension;

        my %args =
                region => $region,
                working-precision => Rat;

        ok Math::NIntegrate::VariableTransformer::DoubleExponential.new(
                :@min-original-bounds,
                :@max-original-bounds,
                :@min-transform-bounds,
                :@max-transform-bounds,
                |%args), 'DoubleExponent object creation is ok';

        my $vt = Math::NIntegrate::VariableTransformer::DoubleExponential.new(
                :@min-original-bounds,
                :@max-original-bounds,
                :@min-transform-bounds,
                :@max-transform-bounds,
                |%args);

        isa-ok $vt.transform(point => [1 / 3, 8], jacobian => 1), Map:D, 'method .transform returns Map:D';

        is $vt.working-precision ~~ Rat, True, 'expected working precision';

        is-approx
                $vt.transform(point => [1 / 3, 8], jacobian => 1)<point>[0],
                2.4638108958034195,
                'expected X-coordinate DT transformed value';

        is-approx
                $vt.transform(point => [1 / 3, 8], jacobian => 1)<point>[1],
                10,
                'expected Y-coordinate DT transformed value';
}, 'Finite ranges';

# 2
subtest {
        my @min = -2, -Inf;
        my @max = Inf, 5;
        my $region = Math::NIntegrate::Region.new(:@min, :@max, :2dimension);

        my @min-original-bounds = |@min;
        my @max-original-bounds = |@max;
        my @min-transform-bounds = 0 xx $region.dimension;
        my @max-transform-bounds = 1 xx $region.dimension;

        my %args =
                region => $region,
                working-precision => Num;

        my $vt = Math::NIntegrate::VariableTransformer::DoubleExponential.new(
                :@min-original-bounds,
                :@max-original-bounds,
                :@min-transform-bounds,
                :@max-transform-bounds,
                |%args);

        isa-ok $vt.transform(point => [1 / 3, 1], jacobian => 1), Map:D, 'method .transform returns Map:D';

        my %res = $vt.transform(point => [1 / 3, 1], jacobian => 1);

        is-approx
                %res<point>[0],
                -0.295368326482353,
                'expected X-coordinate DT transformed value';

        is-approx
                %res<point>[1],
                -1.3344419392569806,
                'expected Y-coordinate DT transformed value';

        # Raku precision on sinh/cosh is not great
        is-approx
                %res<jacobian>,
                2.82777 * 15.3538,
                rel-tol => 10e-5,
                'expected Jacobian DT transformed value';

}, 'Semi-infinite ranges';

# 2
subtest {
        my @min = -Inf;
        my @max = Inf;
        my $region = Math::NIntegrate::Region.new(:@min, :@max, :1dimension);

        my @min-original-bounds = |@min;
        my @max-original-bounds = |@max;
        my @min-transform-bounds = 0 xx $region.dimension;
        my @max-transform-bounds = 1 xx $region.dimension;

        my %args =
                region => $region,
                working-precision => Num;

        my $vt = Math::NIntegrate::VariableTransformer::DoubleExponential.new(
                :@min-original-bounds,
                :@max-original-bounds,
                :@min-transform-bounds,
                :@max-transform-bounds,
                |%args);

        isa-ok $vt.transform(point => [1 / 3,], jacobian => 1), Map:D, 'method .transform returns Map:D';

        my %res = $vt.transform(point => [1 / 3,], jacobian => 1);

        is-approx
                %res<point>[0],
                0.5589973400021553,
                'expected X-coordinate DT transformed value';

        is-approx
                %res<jacobian>[0],
                1.90046,
                rel-tol => 10e-5,
                'expected Jacobian DT transformed value';

}, 'Infinite ranges';

done-testing;

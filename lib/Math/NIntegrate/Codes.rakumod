use v6.d;

unit module Math::NIntegrate::Codes;

#| Range boundaries cases
our enum RangeBoundsCases is export {
VT_FIN_FIN => 1000,
VT_FIN_INF => 1001,
VT_INF_FIN => 1002,
VT_INF_INF => 1003
};

#| Error codes
enum Errors is export {
ABSTRACT_CLASS_CALL => 2000,
DIMENSIONS_DO_NOT_MATCH => 2001,
INCORRECT_ARGUMENTS => 2002,
INCORRECT_NUMERICAL_FUNCTION => 2003,
INVALID_USE_OF_INF_IN_RANGE => 2004,
MISSING_OBJECT => 2005,
NOT_A_NUMERICAL_FUNCTION => 2006,
REACHED_MAX_POINTS => 2007,
REACHED_MAX_RECURSION => 2008,
WRONG_TYPE => 2009,
ZERO_INTERVAL => 2010
};